{
    "name": "duyler/worker-pool",
    "description": "Process manager for parallel task execution with load balancing",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "worker",
        "pool",
        "process",
        "parallel",
        "fork",
        "duyler"
    ],
    "authors": [
        {
            "name": "Mikhail Ilinsky",
            "email": "mail@milinsky.ru"
        }
    ],
    "require": {
        "php": "^8.4",
        "ext-sockets": "*",
        "psr/log": "^3.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.90",
        "vimeo/psalm": "^6.10",
        "phpunit/phpunit": "^13.0",
        "rector/rector": "^1.2"
    },
    "autoload": {
        "psr-4": {
            "Duyler\\WorkerPool\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Duyler\\WorkerPool\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
