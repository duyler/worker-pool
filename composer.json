{
    "name": "duyler/worker-pool",
    "description": "Process manager with load balancing for Duyler Framework",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "worker",
        "pool",
        "process",
        "parallel",
        "fork",
        "duyler"
    ],
    "authors": [
        {
            "name": "Mikhail Ilinsky",
            "email": "mail@milinsky.ru"
        }
    ],
    "require": {
        "php": "^8.4",
        "ext-sockets": "*",
        "ext-pcntl": "*",
        "ext-posix": "*",
        "duyler/http-server": "@dev",
        "nyholm/psr7": "^1.8",
        "psr/http-message": "^2.0",
        "psr/log": "^3.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.90",
        "infection/infection": "^0.33",
        "phpunit/phpunit": "^13.0",
        "rector/rector": "^1.2",
        "vimeo/psalm": "^6.10"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../http-server"
        }
    ],
    "autoload": {
        "psr-4": {
            "Duyler\\WorkerPool\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Duyler\\WorkerPool\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true,
        "allow-plugins": {
            "infection/extension-installer": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
